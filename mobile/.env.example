# Public build-time values only. Every EXPO_PUBLIC_* value is inlined into the app bundle, so never put a secret here.
# Leave it unset in development and the app reaches the Next.js server on port 3000 of the machine running Metro,
# which also works on a physical phone on the same Wi-Fi. Set it when the backend runs elsewhere, on another port,
# or when Metro runs with --tunnel.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
